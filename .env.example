# ---- Spresy configuration ----
# Copy to backend/.env and fill in your keys. Without keys the app still runs
# (rule-based fallbacks), but AI features are disabled.

# ---- Deployment ----
ENV=local
DATABASE_URL=
FRONTEND_URL=

# ---- Gemini API (Primary LLM) ----
GEMINI_API_KEY=

# ---- Groq Cloud API (fast LLM) — for query expansion, lead scoring, extraction ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- NVIDIA NIM API (OpenAI-compatible) — for embeddings & classification ----
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct

# ---- Tier 1: Official APIs (reliable, legal; run first) ----
# Google Places API — business name/address/phone/website/rating
GOOGLE_PLACES_API_KEY=
# Yelp Fusion API — free tier, similar data
YELP_FUSION_API_KEY=
# OpenCorporates — company registry (India: 'in' jurisdiction, works without key)
OPENCORPORATES_API_KEY=
# Hunter.io — verified business email finder (paid)
HUNTER_API_KEY=
# MCA India company registry — public, no key required

# Optional: SerpAPI key unlocks Google Maps local results (recommended)
SERPAPI_KEY=

# Optional: Playwright for JS-heavy anti-bot sources (JustDial/Sulekha)
# Install:  pip install playwright && playwright install chromium
USE_PLAYWRIGHT=false

# Crawler tuning
USER_AGENT=SpresyBot/1.0 (+legal lead research; respecting robots.txt)
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=20.0
DEFAULT_DELAY_SECONDS=1.5
MAX_PAGES_PER_SITE=8
MAX_TOTAL_LEADS=250
RESULTS_PER_SOURCE=20

# Storage
OUTPUT_DIR=output
